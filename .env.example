# ==============================================================
# .env.example  –  RevvFi Protocol environment template
# Copy this file to .env.localnet / .env.testnet / .env.mainnet
# and fill in the values.  Never commit real keys to git.
# ==============================================================

# --- Network RPC ---
RPC_URL=http://127.0.0.1:8545         # localnet (Anvil)
SEPOLIA_RPC_URL=                      # required for testnet — https://eth-sepolia.g.alchemy.com/v2/<KEY>
MAINNET_RPC_URL=                      # https://eth-mainnet.g.alchemy.com/v2/<KEY>
POLYGON_RPC_URL=                      # required for DeployMainnet.s.sol (Polygon) — https://polygon-mainnet.g.alchemy.com/v2/<KEY>

# --- Deployer (admin) ---
PRIVATE_KEY=                          # hex private key, 0x-prefixed. Deploys all infra, owns Factory/ArchController.

# --- Protocol roles ---
BORROWER=                             # address registered as borrower (must match BORROWER_PRIVATE_KEY below)
BORROWER_PRIVATE_KEY=                 # required by DeployRevvFi.s.sol (testnet) and DeployMainnet.s.sol.
                                       # A separate wallet from PRIVATE_KEY — calls factory.deployMarket() and
                                       # pays the deployment fee itself. On localnet this may be omitted (falls
                                       # back to the deployer key); on testnet/mainnet it is required.
FEE_RECIPIENT=                        # receives market deployment fees (defaults to deployer)

# --- Token addresses ---
# Leave blank on testnet to auto-deploy freely-mintable mock USDC/WETH.
# Set to real token addresses to reuse existing tokens instead (required on mainnet).
USDC_ADDRESS=
WETH_ADDRESS=

# --- Chainlink oracle ---
# Leave blank to use the network's known-good default (Sepolia ETH/USD is
# hardcoded as a fallback in DeployRevvFi.s.sol; Polygon ETH/USD in DeployMainnet.s.sol).
# Set explicitly to point at a different feed.
ORACLE_ETH_USD=

# --- Contract verification ---
ETHERSCAN_API_KEY=                    # https://etherscan.io/myapikey — used for mainnet/sepolia verification
POLYGONSCAN_API_KEY=                  # https://polygonscan.com/myapikey — used for polygon verification
